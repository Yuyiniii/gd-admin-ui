# 生产环境配置
#
# 注意：生产构建的环境变量在 `pnpm build` 时静态注入到产物里，
# 部署后无法热改。修改后必须重新构建。
# 若需要"一次构建、多环境部署"，请改用 nginx 反代 + 同源路径（推荐）。

# 应用标题
VITE_APP_TITLE = 管理系统

# 本地预览端口（pnpm preview 时使用，不影响部署）
VITE_PORT = 9090

# 生产环境 API 基地址
# 推荐方案：留空，让请求走同源（前端和 API 由同一个 nginx 反代）。
# 如必须跨域请求，请改为真实域名，例如 https://api.example.com
VITE_API_BASE_URL =

# API 前缀。所有请求会拼成 ${VITE_API_BASE_URL}${VITE_API_PREFIX}/...
# 若使用同源部署，nginx 需要把 /prod-api 反代到后端。
VITE_API_PREFIX = /prod-api

# 是否启用 Vite dev-server 代理（生产环境无意义，保持 false）
VITE_PROXY_ENABLED = false
